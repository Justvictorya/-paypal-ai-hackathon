# PayPal Sandbox Credentials (get from https://developer.paypal.com/dashboard/)
# PAYPAL_CLIENT_ID=your_sandbox_client_id_here
# PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# Optional: Custom PayPal API base (default: https://api-m.sandbox.paypal.com)
# PAYPAL_BASE=https://api-m.sandbox.paypal.com

# Optional: Merchant name and currency
# PAYPAL_MERCHANT=Your Store Name
# PAYPAL_CURRENCY=USD

# Optional: Return/cancel URLs for PayPal approval flow
# PAYPAL_RETURN_URL=https://yourdomain.com/return
# PAYPAL_CANCEL_URL=https://yourdomain.com/cancel

# Optional: PayPal MCP endpoint (if using PayPal Agent Toolkit MCP)
# PAYPAL_MCP_URL=https://mcp.sandbox.paypal.com
# PAYPAL_ACCESS_TOKEN=your_mcp_access_token

# Server port (default: 8403)
# PORT=8403

# Ollama model for policy compilation (default: llama3.2:3b)
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_HOST=http://127.0.0.1:11434